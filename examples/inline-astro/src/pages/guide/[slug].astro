---
import content from '../../../content.json';
import '../../style.css';
export function getStaticPaths() {
  return content.entries.map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{entry.title} — Workshop guide</title></head>
<body><main><a href={import.meta.env.BASE_URL}>Back to the workshop guide</a><h1>{entry.title}</h1>
<p>{entry.category}</p><p>{entry.body}</p></main></body></html>
