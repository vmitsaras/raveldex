---
import content from '../../content.json';
const base=import.meta.env.BASE_URL;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Walking resource directory</title></head>
<body><main><header class="demo-intro"><h1>Resources for a day outdoors</h1><p>Find a guide, checklist or tool. Search words and select several topics.</p></header>
<p data-directory-status role="status">Browse the resources below. Search needs JavaScript.</p><button type="button" data-directory-retry hidden>Enable directory</button>
<p data-directory-url-status role="status" hidden></p><button type="button" data-directory-url-retry hidden>Update search link</button>
<section data-directory-root aria-label="Walking resource directory" data-build-id={content.buildId}><p>All resources remain available in the list below.</p></section>
<nav aria-label="Browse all resources"><h2>All resources</h2><ul>{content.entries.map(entry=><li><a href={base+entry.path.slice(1)}>{entry.title}</a></li>)}</ul></nav>
</main><script>import '../main.mjs';</script></body></html>
