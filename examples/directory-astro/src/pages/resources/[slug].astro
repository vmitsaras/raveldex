---
import content from '../../../content.json';
import '../../style.css';
export function getStaticPaths(){return content.entries.map(entry=>({params:{slug:entry.path.slice('/resources/'.length,-1)},props:{entry}}));}
const {entry}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{entry.title}</title></head>
<body><main><a href={import.meta.env.BASE_URL}>Back to the resource directory</a><p>{entry.format} · {entry.topics.join(', ')}</p><h1>{entry.title}</h1><p>{entry.body}</p></main></body></html>
