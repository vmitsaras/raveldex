{
  "kind": "raveldex-page-sections-url-fixture-v1",
  "role": "Literal direct-parent and encoded section URL expectations; directory-route static inputs remain stricter.",
  "cases": [
    {
      "id": "direct-query-preserved",
      "mapped": true,
      "parentURL": "https://docs.example/help/guide/a/?lang=el&view=compact",
      "anchor": "%#café",
      "expectedURL": "https://docs.example/help/guide/a/?lang=el&view=compact#%25%23caf%C3%A9"
    },
    {
      "id": "percent-is-raw-id",
      "mapped": true,
      "parentURL": "https://docs.example/help/guide/a/",
      "anchor": "%2F",
      "expectedURL": "https://docs.example/help/guide/a/#%252F"
    },
    {
      "id": "mapped-parent-fragment",
      "mapped": true,
      "parentURL": "https://docs.example/help/guide/a/#intro",
      "anchor": "details",
      "expectedCode": "INVALID_OPTIONS",
      "expected": "reject mapping before authored DOM replacement; do not replace caller fragment"
    },
    {
      "id": "mapped-parent-empty-fragment",
      "mapped": true,
      "parentURL": "https://docs.example/help/guide/a/#",
      "anchor": "details",
      "expectedCode": "INVALID_OPTIONS",
      "expected": "reject even an empty literal fragment delimiter"
    },
    {
      "id": "unmapped-legacy-fragment",
      "mapped": false,
      "parentURL": "https://docs.example/help/guide/a/#intro",
      "expectedURL": "https://docs.example/help/guide/a/#intro",
      "expected": "existing ordinary UIDocument behavior remains unchanged; no section URL is fabricated"
    },
    {
      "id": "resolved-url-2048",
      "mapped": true,
      "parentURL": "https://docs.",
      "anchor": "a",
      "expectedURL": "https://docs.#a",
      "expectedLength": 2048
    },
    {
      "id": "resolved-url-2049",
      "mapped": true,
      "parentURL": "https://docs.",
      "anchor": "a",
      "candidateLength": 2049,
      "expectedCode": "LIMIT_EXCEEDED",
      "expected": "reject full URL; do not truncate ID or path"
    },
    {
      "id": "anchor-target-not-crawled",
      "mapped": true,
      "parentURL": "https://docs.example/help/guide/a/",
      "anchor": "application-authored-id",
      "expectedURL": "https://docs.example/help/guide/a/#application-authored-id",
      "expected": "the application must render this exact target; library does not fetch or inspect destination HTML"
    }
  ]
}
