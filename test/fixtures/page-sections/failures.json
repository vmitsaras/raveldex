      "stage": "capture",
      "change": {
        "appendPageId": "page:a"
      },
      "expected": {
        "code": "INVALID_OPTIONS",
        "presentation": "capture rejected; authored DOM and borrowed owner unchanged"
      }
    },
    {
      "id": "unknown-display-page",
      "stage": "capture",
