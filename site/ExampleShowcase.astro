---
import Layout from './Layout.astro';
import SolutionChooser from './SolutionChooser.astro';
import DemoPreview from './DemoPreview.astro';
const { family, title, description, previewTitle, previewHeight = 720, pilot = false } = Astro.props;
const preview = `/raveldex/examples/${family}-preview/`;
---
<Layout wide frontmatter={{ title }}>
  <div class="example-showcase">
    <header class="example-showcase__intro">
      <div><h1>{title}</h1><p>{description}</p></div>
      <a class="example-showcase__open" href={preview}>Open full preview
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
      </a>
    </header>
    {!pilot && <SolutionChooser current={family} compare={false} />}
    {pilot ? <DemoPreview family={family} previewTitle={previewTitle} previewHeight={previewHeight}><slot name="preview-hint" /></DemoPreview> : <section class="example-showcase__preview" aria-labelledby={`try-${family}`}>
      <header class="example-showcase__toolbar">
        <h2 id={`try-${family}`}>Try {family === 'cards' ? 'rich result cards' : family === 'directory' ? 'the resource directory' : `${family} search`}</h2>
        <p><slot name="preview-hint" /></p>
      </header>
      <iframe src={preview} title={previewTitle} loading="lazy" height={previewHeight}></iframe>
    </section>}
    <div class="example-showcase__docs site-main--article"><slot /></div>
    {pilot && <><h2>Related interfaces</h2><SolutionChooser current={family} compare={false} /></>}
    <p class="example-showcase__compare"><a href="/raveldex/examples/#choose-a-search-solution">Compare solutions and requirements</a></p>
  </div>
  {pilot && <script is:inline type="module" src="/raveldex/site-assets/example-controls.mjs"></script>}
</Layout>

<style is:global>
  .example-showcase { max-inline-size: 78rem; margin-inline: auto; }
  .example-showcase__intro { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem 3rem; margin-block-end: 1.5rem; }
  .example-showcase__intro > div { max-inline-size: 54rem; }
  .example-showcase__intro h1 { margin: 0 0 .75rem; font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 720; line-height: 1.1; letter-spacing: -.035em; text-wrap: balance; }
  .example-showcase__intro p { max-inline-size: 66ch; margin: 0; color: #536171; font-size: 1.0625rem; line-height: 1.65; }
  .site a.example-showcase__open { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; gap: .65rem; min-block-size: 2.75rem; padding: .65rem 1rem; border: 1px solid #dce0e5; border-radius: .65rem; background: #f8f9fa; color: #151b21; font-size: .875rem; font-weight: 600; text-decoration: none; }
  .site a.example-showcase__open:hover { background: #edf0f3; border-color: #a5adb6; }
  .example-showcase__open svg { flex: 0 0 auto; }
  .example-showcase .solution-chooser { margin-block-end: 1.25rem; }
  .example-showcase .solution-chooser ul { gap: .25rem; margin: 0; border-block-end: 1px solid #dce0e5; }
  .example-showcase .solution-chooser a { min-block-size: 2.75rem; padding: .5rem 1rem; border-radius: .5rem; color: #536171; font-size: .9375rem; font-weight: 500; text-decoration: none; }
  .example-showcase .solution-chooser a:hover { background: #f4f6f8; color: #151b21; }
  .example-showcase .solution-chooser a[aria-current="page"] { background: #edf2f7; color: #075ca8; font-weight: 650; }
  .example-showcase__preview { overflow: hidden; border: 1px solid #dce0e5; border-radius: 1rem; background: #f8f9fa; }
  .example-showcase__toolbar { display: grid; grid-template-columns: minmax(12rem, .65fr) minmax(0, 1.35fr); align-items: center; gap: .75rem 2rem; padding: 1.15rem 1.5rem; border-block-end: 1px solid #dce0e5; }
  .example-showcase__toolbar h2 { margin: 0; font-size: 1rem; line-height: 1.4; font-weight: 650; letter-spacing: -.01em; }
  .example-showcase__toolbar p { margin: 0; color: #536171; font-size: .875rem; line-height: 1.6; }
  .example-showcase__preview iframe { display: block; inline-size: 100%; max-inline-size: 100%; border: 0; background: #fff; }
  .example-showcase__docs { margin: 3rem auto 2rem; }
  .example-showcase__docs > :is(p, ul, ol, details) { max-inline-size: 76ch; }
  .example-showcase__docs > h2 { max-inline-size: 30ch; margin-block: 2.75rem 1rem; font-size: 1.75rem; line-height: 1.2; letter-spacing: -.025em; }
  .example-showcase__docs details { margin-block: 1.25rem; padding-block: .75rem; border-block: 1px solid #e5e7eb; }
  .example-showcase__docs summary { min-block-size: 2.75rem; padding-block: .5rem; color: #151b21; cursor: pointer; font-weight: 600; }
  .example-showcase__docs details > :not(summary) { color: #536171; }
  .example-showcase__docs li { padding-inline-start: .25rem; margin-block: .6rem; }
  .example-showcase__docs pre { font-size: .875rem; }
  .example-showcase__docs .starter-setup__project { margin-block: 1.75rem; padding-block: 1.75rem; border-block-start: 1px solid #dce0e5; }
  .example-showcase__docs .starter-setup__project h3 { margin-block: 0 .75rem; font-size: 1.25rem; letter-spacing: -.02em; }
  .example-showcase__docs .starter-setup__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.25rem; margin-block: .75rem 1.25rem; }
  .example-showcase__docs .starter-setup__actions a { display: inline-flex; align-items: center; min-block-size: 2.75rem; font-size: .875rem; }
  .example-showcase__docs .starter-setup__actions a[download] { padding: .5rem .85rem; border: 1px solid #dce0e5; border-radius: .5rem; background: #f8f9fa; color: #151b21; font-weight: 600; text-decoration: none; }
  .example-showcase__docs .starter-setup__actions a[download]:hover { border-color: #a5adb6; background: #edf0f3; }
  .example-showcase__compare { margin-block: 2rem 3rem; font-size: .875rem; }
  @media (max-width: 47.99rem) {
    .example-showcase__intro { display: block; }
    .example-showcase__intro h1 { font-size: 2rem; }
    .example-showcase__intro p { font-size: 1rem; }
    .example-showcase__open { margin-block-start: 1rem; }
    .example-showcase .solution-chooser a { padding-inline: .7rem; font-size: .875rem; }
    .example-showcase__toolbar { display: block; padding: 1rem; }
    .example-showcase__toolbar h2 { margin-block-end: .35rem; }
    .example-showcase__docs { margin-block-start: 2rem; }
  }
  @media (forced-colors: active) {
    .example-showcase__preview, .example-showcase .solution-chooser ul { border-color: CanvasText; }
    .site a.example-showcase__open, .example-showcase .solution-chooser a[aria-current="page"] { border: 1px solid ButtonText; color: LinkText; }
    .example-showcase__intro p, .example-showcase__toolbar p, .example-showcase__docs details > :not(summary) { color: CanvasText; }
  }
</style>
<style is:global>
  .example-pilot [hidden], .example-showcase__docs [hidden] { display: none !important; }
  .example-controls { padding: 1rem; border-block-end: 1px solid #dce0e5; }
  .example-controls button, .example-code button { font: inherit; padding: .5rem .8rem; border: 1px solid #7a8795; border-radius: .3rem; background: #fff; color: #151b21; }
  .example-controls button[aria-pressed="true"] { background: #edf2f7; border-block-end: 3px solid #075ca8; font-weight: 700; }
  .example-source { padding: 1rem; min-inline-size: 0; }
  .example-code { min-inline-size: 0; margin-block: 1rem; border-block: 1px solid #dce0e5; padding-block: .5rem; }
  .example-code summary { cursor: pointer; padding-block: .65rem; overflow-wrap: anywhere; }
  .example-code pre { max-inline-size: 100%; overflow-x: auto; padding: 1rem; font-size: .875rem; }
  .example-pilot label, .example-showcase__docs [data-choice-label] { display: block; margin-block: 1rem; }
  .example-pilot select, .example-showcase__docs select { font: inherit; padding: .5rem; max-inline-size: 100%; }
</style>
