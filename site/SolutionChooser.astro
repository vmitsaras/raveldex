---
import { SOLUTIONS } from './solutions.mjs';
const { current, describe = false, compare = true } = Astro.props;
const base = '/raveldex/';
---
<nav class:list={['solution-chooser', { 'solution-chooser--described': describe }]} aria-label="Search solutions">
  <ul>{SOLUTIONS.map(({ id, label, description }) => <li><a href={base + `examples/${id}/`} aria-current={current === id ? 'page' : undefined}>{label}</a>{describe && <p>{description}</p>}</li>)}</ul>
</nav>
{compare && <p><a href={base + 'examples/#choose-a-search-solution'}>Compare solutions and requirements</a></p>}
<style>
  .solution-chooser ul { display: flex; flex-wrap: wrap; gap: .5rem 1rem; list-style: none; padding: 0 0 .8rem; }
  .solution-chooser--described ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1rem 2rem; }
  .solution-chooser li { min-inline-size: 0; overflow-wrap: anywhere; }
  .solution-chooser--described p { margin-block: .25rem 0; }
  .solution-chooser a { display: inline-block; padding-block: .5rem; }
  .solution-chooser a[aria-current="page"] { font-weight: 700; text-decoration-thickness: .15em; }
  .solution-chooser a:focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }
</style>
