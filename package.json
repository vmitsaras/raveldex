{
  "name": "@vmitsaras/raveldex",
  "version": "0.0.0",
  "private": true,
  "description": "Native modular TypeScript local search \u2014 ESM core with BM25, atomic mutations, cooperative execution, optional search capabilities and native DOM UI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vmitsaras/raveldex.git"
  },
  "bugs": {
    "url": "https://github.com/vmitsaras/raveldex/issues"
  },
  "homepage": "https://github.com/vmitsaras/raveldex#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run handoff:check && npm run docs:check && npm run typecheck && npm test",
    "test": "npm run build && node --test --test-concurrency=4 --test-timeout=180000 test/tooling/*.test.mjs test/core/*.test.mjs test/consumer/*.test.mjs test/addons/phrases/*.test.mjs test/addons/positions/*.test.mjs test/addons/filters/*.test.mjs test/addons/facets/*.test.mjs test/addons/inspector/*.test.mjs test/addons/evidence/*.test.mjs test/adapters/snapshots/*.test.mjs test/migration/converter.test.mjs test/comparison/*.test.mjs && node --test --test-timeout=120000 test/ui/*.test.mjs && node --test --test-timeout=120000 test/adapters/worker/*.test.mjs && node --test --test-timeout=120000 test/adapters/indexeddb/*.test.mjs && node --test --test-timeout=120000 test/migration/packed-browser.test.mjs",
    "handoff:check": "node scripts/plan.mjs check",
    "handoff:status": "node scripts/plan.mjs status",
    "handoff:next": "node scripts/plan.mjs next",
    "docs:generate": "node scripts/render-plan.mjs",
    "docs:check": "node scripts/render-plan.mjs --check && node scripts/check-docs.mjs",
    "tracking:preview": "node scripts/sync-github.mjs --dry-run",
    "tracking:sync": "node scripts/sync-github.mjs --apply",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/types/tsconfig.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.indexeddb.json && tsc -p tsconfig.migration.json",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.ui.build.json && node scripts/copy-ui-css.mjs && tsc -p tsconfig.worker.build.json && tsc -p tsconfig.indexeddb.build.json && tsc -p tsconfig.migration.build.json && node scripts/copy-migration-license.mjs",
    "test:core": "npm run build && node --test test/core/*.test.mjs",
    "prepack": "npm run build",
    "test:consumer": "npm run build && node --test test/consumer/*.test.mjs",
    "pilot:core": "npm run build && node scripts/core-pilot.mjs",
    "test:phrases": "npm run build && node --test test/addons/phrases/*.test.mjs",
    "test:positions": "npm run build && node --test test/addons/positions/*.test.mjs",
    "test:filters": "npm run build && node --test test/addons/filters/*.test.mjs",
    "test:facets": "npm run build && node --test test/addons/facets/*.test.mjs",
    "test:inspector": "npm run build && node --test test/addons/inspector/*.test.mjs",
    "test:evidence": "npm run build && node --test test/addons/evidence/*.test.mjs",
    "test:ui": "npm run build && node --test test/ui/*.test.mjs",
    "pilot:ui": "npm run build && node scripts/ui-pilot.mjs",
    "test:worker": "npm run build && node --test --test-timeout=120000 test/adapters/worker/*.test.mjs",
    "test:snapshots": "npm run build && node --test --test-timeout=120000 test/adapters/snapshots/*.test.mjs",
    "measure:snapshots": "npm run build && node --expose-gc scripts/snapshot-costs.mjs",
    "test:indexeddb": "npm run build && node --test --test-timeout=120000 test/adapters/indexeddb/*.test.mjs",
    "test:migration": "npm run build && node --test --test-timeout=120000 test/migration/converter.test.mjs test/comparison/*.test.mjs && node --test --test-timeout=120000 test/migration/packed-browser.test.mjs"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.61.1",
    "typescript": "7.0.2"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./addons/phrases": {
      "types": "./dist/addons/phrases/index.d.ts",
      "import": "./dist/addons/phrases/index.js"
    },
    "./addons/phrases/source": {
      "types": "./dist/addons/phrases/source.d.ts",
      "import": "./dist/addons/phrases/source.js"
    },
    "./addons/positions": {
      "types": "./dist/addons/positions/index.d.ts",
      "import": "./dist/addons/positions/index.js"
    },
    "./addons/phrases/positions": {
      "types": "./dist/addons/positions/phrases.d.ts",
      "import": "./dist/addons/positions/phrases.js"
    },
    "./addons/phrases/mixed": {
      "types": "./dist/addons/phrases/mixed.d.ts",
      "import": "./dist/addons/phrases/mixed.js"
    },
    "./addons/filters": {
      "types": "./dist/addons/filters/index.d.ts",
      "import": "./dist/addons/filters/index.js"
    },
    "./addons/facets": {
      "types": "./dist/addons/facets/index.d.ts",
      "import": "./dist/addons/facets/index.js"
    },
    "./addons/inspector": {
      "types": "./dist/addons/inspector/index.d.ts",
      "import": "./dist/addons/inspector/index.js"
    },
    "./addons/evidence": {
      "types": "./dist/addons/evidence/index.d.ts",
      "import": "./dist/addons/evidence/index.js"
    },
    "./addons/snippets": {
      "types": "./dist/addons/snippets/index.d.ts",
      "import": "./dist/addons/snippets/index.js"
    },
    "./addons/ui": {
      "types": "./dist/addons/ui/index.d.ts",
      "import": "./dist/addons/ui/index.js"
    },
    "./addons/ui/styles.css": "./dist/addons/ui/styles.css",
    "./adapters/worker": {
      "types": "./dist/adapters/worker/index.d.ts",
      "import": "./dist/adapters/worker/index.js"
    },
    "./adapters/worker/host": {
      "types": "./dist/adapters/worker/host-entry.d.ts",
      "import": "./dist/adapters/worker/host-entry.js"
    },
    "./adapters/snapshots": {
      "types": "./dist/adapters/snapshots/index.d.ts",
      "import": "./dist/adapters/snapshots/index.js"
    },
    "./adapters/indexeddb": {
      "types": "./dist/adapters/indexeddb/index.d.ts",
      "import": "./dist/adapters/indexeddb/index.js"
    },
    "./adapters/worker/snapshots": {
      "types": "./dist/adapters/worker/snapshots.d.ts",
      "import": "./dist/adapters/worker/snapshots.js"
    },
    "./adapters/worker/snapshots/host": {
      "types": "./dist/adapters/worker/snapshots-host.d.ts",
      "import": "./dist/adapters/worker/snapshots-host.js"
    },
    "./integrations/localsearch": {
      "types": "./dist/integrations/localsearch/index.d.ts",
      "import": "./dist/integrations/localsearch/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/core/",
    "dist/addons/phrases/",
    "dist/addons/positions/",
    "dist/addons/filters/",
    "dist/addons/facets/",
    "dist/addons/metadata/",
    "dist/addons/inspector/",
    "dist/addons/evidence/",
    "dist/addons/snippets/",
    "dist/addons/ui/",
    "dist/adapters/worker/",
    "dist/adapters/snapshots/",
    "dist/adapters/indexeddb/",
    "dist/integrations/localsearch/"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
