{
  "name": "@vmitsaras/raveldex",
  "version": "0.0.0",
  "private": true,
  "description": "Native modular TypeScript local search \u2014 ESM core with BM25, atomic mutations, cooperative execution and optional phrases, filters, facets and factual inspection.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vmitsaras/raveldex.git"
  },
  "bugs": {
    "url": "https://github.com/vmitsaras/raveldex/issues"
  },
  "homepage": "https://github.com/vmitsaras/raveldex#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run handoff:check && npm run docs:check && npm run typecheck && npm test",
    "test": "npm run build && node --test test/tooling/*.test.mjs test/core/*.test.mjs test/consumer/*.test.mjs test/addons/phrases/*.test.mjs test/addons/positions/*.test.mjs test/addons/filters/*.test.mjs test/addons/facets/*.test.mjs test/addons/inspector/*.test.mjs",
    "handoff:check": "node scripts/plan.mjs check",
    "handoff:status": "node scripts/plan.mjs status",
    "handoff:next": "node scripts/plan.mjs next",
    "docs:generate": "node scripts/render-plan.mjs",
    "docs:check": "node scripts/render-plan.mjs --check && node scripts/check-docs.mjs",
    "tracking:preview": "node scripts/sync-github.mjs --dry-run",
    "tracking:sync": "node scripts/sync-github.mjs --apply",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/types/tsconfig.json",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "test:core": "npm run build && node --test test/core/*.test.mjs",
    "prepack": "npm run build",
    "test:consumer": "npm run build && node --test test/consumer/*.test.mjs",
    "pilot:core": "npm run build && node scripts/core-pilot.mjs",
    "test:phrases": "npm run build && node --test test/addons/phrases/*.test.mjs",
    "test:positions": "npm run build && node --test test/addons/positions/*.test.mjs",
    "test:filters": "npm run build && node --test test/addons/filters/*.test.mjs",
    "test:facets": "npm run build && node --test test/addons/facets/*.test.mjs",
    "test:inspector": "npm run build && node --test test/addons/inspector/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./addons/phrases": {
      "types": "./dist/addons/phrases/index.d.ts",
      "import": "./dist/addons/phrases/index.js"
    },
    "./addons/phrases/source": {
      "types": "./dist/addons/phrases/source.d.ts",
      "import": "./dist/addons/phrases/source.js"
    },
    "./addons/positions": {
      "types": "./dist/addons/positions/index.d.ts",
      "import": "./dist/addons/positions/index.js"
    },
    "./addons/phrases/positions": {
      "types": "./dist/addons/positions/phrases.d.ts",
      "import": "./dist/addons/positions/phrases.js"
    },
    "./addons/phrases/mixed": {
      "types": "./dist/addons/phrases/mixed.d.ts",
      "import": "./dist/addons/phrases/mixed.js"
    },
    "./addons/filters": {
      "types": "./dist/addons/filters/index.d.ts",
      "import": "./dist/addons/filters/index.js"
    },
    "./addons/facets": {
      "types": "./dist/addons/facets/index.d.ts",
      "import": "./dist/addons/facets/index.js"
    },
    "./addons/inspector": {
      "types": "./dist/addons/inspector/index.d.ts",
      "import": "./dist/addons/inspector/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/core/",
    "dist/addons/phrases/",
    "dist/addons/positions/",
    "dist/addons/filters/",
    "dist/addons/facets/",
    "dist/addons/metadata/",
    "dist/addons/inspector/"
  ],
  "sideEffects": false
}
